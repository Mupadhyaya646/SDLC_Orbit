# ---- required ---------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/postgres
# In CATS use POSTGRES_HOST / POSTGRES_PORT / POSTGRES_USERNAME / POSTGRES_PASSWORD instead.

# LLM: Anthropic
ANTHROPIC_API_KEY=
# Defaults: LLM_MODEL_OPUS=claude-opus-5-5 (design, review, devops, commit, docs, unit-test)
#           LLM_MODEL_SONNET=claude-sonnet-5-5 (admin, developer)
# LLM_MODEL_OPUS=               # e.g. claude-fable-5-1 = most capable (slower, ~2.5x price)
# LLM_MODEL_SONNET=             # e.g. claude-haiku-5-5 = lowest latency
# LLM_MODEL=                    # optional: one model for every agent
# LLM_TEMPERATURE=              # not sent by default (adaptive thinking is always on for the 5.5 models)
# Do not change model ids while sessions are mid-run (thinking blocks are tied to the model).
# ANTHROPIC_BASE_URL=           # optional Anthropic-compatible gateway
# LLM_EXTRA_HEADERS=x-application-id=abc   # optional static gateway headers

# ---- MCP toolkit servers (Lane 4) -------------------------------------------
ORBIT_K8S_NAMESPACE=sdlc-orbit-dev   # your infra currently deploys these to felix-dev: rename it, or set the URLs below
# MCP_CONFLUENCE_URL=http://confluence-mcp.sdlc-orbit-dev.svc.cluster.local:6001/mcp
# MCP_SALESFORCE_URL=http://salesforce-mcp.sdlc-orbit-dev.svc.cluster.local:6000/mcp      # admin / developer / unit-testing
# MCP_SALESFORCE_QA_URL=...                                                               # defaults to MCP_SALESFORCE_URL
# MCP_SALESFORCE_PROD_URL=...                                                             # NO default: Prod fails closed if unset
# MCP_GITOPS_URL=http://gitops-mcp.sdlc-orbit-dev.svc.cluster.local:6002/mcp

# ---- behaviour --------------------------------------------------------------
ORBIT_ENV=dev
ORBIT_MAX_REWORK_LOOPS=3
ORBIT_REQUIRE_DESIGN_CONFIRMATION=true
# IDENTITY_MODE=auto            # auto | header | dev
# IDENTITY_HEADER=              # header carrying the verified user (default: x-amzn-oidc-data, x-forwarded-email, ...)
# IDENTITY_STRICT=false         # true => reject replies with no verified identity (turn on once the header is confirmed)
